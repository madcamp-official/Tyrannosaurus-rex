# Plan.md §22.4. server/ 워크스페이스가 읽는 환경 변수. 실제 값은 .env(.local)에 넣고 커밋하지 않는다.

NODE_ENV=development
SERVER_PORT=3001
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_JOIN_ORIGIN=http://localhost:5173
APP_VERSION=1.0.0
API_VERSION=1
GODOT_ASSET_VERSION=dev
LOG_LEVEL=info
ROOM_IDLE_TTL_MS=1800000
ROUND_DURATION_MS=300000
